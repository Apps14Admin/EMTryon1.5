{
  "entities": {
    "UsageRecord": {
      "title": "Usage Record",
      "description": "Tracks the number of images generated by a user in a specific month.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The unique ID of the user."
        },
        "month": {
          "type": "string",
          "description": "The month in YYYY-MM format."
        },
        "count": {
          "type": "integer",
          "description": "The number of images generated."
        },
        "lastUpdated": {
          "type": "string",
          "format": "date-time",
          "description": "The last time the counter was updated."
        }
      },
      "required": ["userId", "month", "count", "lastUpdated"]
    }
  },
  "firestore": {
    "/usage/{usageId}": {
      "schema": "UsageRecord",
      "description": "Monthly usage statistics for users."
    }
  }
}
