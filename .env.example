# Copy to .env and fill in the values:  cp .env.example .env
# .env is gitignored — never commit real keys.

# ---- Required ----------------------------------------------------------
# ONE key per provider. There is deliberately no separate key for analysis and
# generation: each provider's two model ids are reached with the same
# credential, so GEMINI_ANALYSIS_KEY / GEMINI_IMAGE_KEY and their OpenAI
# equivalents do not exist and must not be added.
#
# Gemini API key. Used SERVER-SIDE only: server.js attaches it to requests
# and vite.config.ts does the same for the dev proxy. It is deliberately not
# exposed to the browser — do not add a VITE_ prefixed copy of it.
#
# AVAILABLE GEMINI MODELS (the application's configuration; see
# services/aiModels.ts, which is the source of truth):
#   gemini-3.1-flash-lite-image
#   gemini-3.1-flash-image
#   gemini-3-pro-image
# The user selects one and that model is used. The application does not
# discover models from the API, and does not select another one for you.
#
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- Optional: OpenAI ---------------------------------------------------
# Enables the "OpenAI" choice in the AI Provider picker. Selecting it moves the
# WHOLE workflow onto this ONE key, with a fixed model configuration:
#   image analysis   -> gpt-5.6-luna   (Luna; a reasoning model, and slow)
#   image generation -> gpt-image-2    (Image 2; the /images/edits endpoint)
# The user selects OpenAI once; the application knows both models and there
# is nothing further to choose. Used SERVER-SIDE only: server.js and the vite
# dev proxy attach it as a Bearer token. Leave blank and the option reports
# itself unavailable; Gemini is unaffected.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---- Optional: Instagram scheduled publishing --------------------------
# Instagram Graph API token for a Business/Creator account with the
# instagram_content_publish permission.
IG_ACCESS_TOKEN=

# Publicly reachable base URL of this server. Instagram fetches generated
# images by URL, so localhost will not work — use a tunnel (ngrok) locally
# or the deployed Cloud Run URL in production. Leave blank to disable the
# scheduler entirely.
PUBLIC_BASE_URL=

# ---- Off-site image counter --------------------------------------------
# Total images ever generated, kept on a third-party service so the number
# survives redeploys, container restarts (Cloud Run discards the filesystem
# whenever it scales to zero), database changes and swapping AI providers.
#
# server.js increments it by 1 each time a provider actually returns image
# bytes — not per API request, so the angle classifier (which calls an image id
# and gets text back) does not inflate it. There are no retries or model
# fallbacks left to inflate it either. Leave the namespace/key blank to use the
# local file counter (fine for `npm run dev`, useless in production).
#
# Provider is Abacus (https://abacus.jasoncameron.dev). Create a counter with:
#   curl "https://abacus.jasoncameron.dev/create/<namespace>/<key>?initializer=0"
# Keep the key unguessable: anyone who knows namespace+key can increment it.
IMAGE_COUNTER_NAMESPACE=
IMAGE_COUNTER_KEY=

# Swap providers without touching code. Defaults to Abacus.
# IMAGE_COUNTER_URL=https://abacus.jasoncameron.dev

# Returned by /create, and never recoverable afterwards. Not read by the app —
# recorded here so you can correct or reset the tally by hand:
#   curl -X POST -H "Authorization: Bearer <admin key>" \
#     "https://abacus.jasoncameron.dev/set/<namespace>/<key>?value=N"
# IMAGE_COUNTER_ADMIN_KEY=

# How long to wait on the counter service before giving up, in ms.
# IMAGE_COUNTER_TIMEOUT_MS=5000

# ---- Generation Library ------------------------------------------------
# Permanent store for every generated image and its metadata. With the bucket
# set, image bytes go to Cloud Storage under gs://<bucket>/generations/<id>/
# and records to the Firestore collection 'generations' — both reached through
# the service account the Cloud Run container runs as (Application Default
# Credentials), so there is NO key to configure here and none in the bundle.
#
# Leave blank for `npm run dev`: the Library then lives in data/library/ on
# this machine. Do NOT leave it blank in production — the container filesystem
# is discarded on scale-to-zero and redeploys, and the Library with it.
LIBRARY_BUCKET=

# Object key prefix and Firestore collection, if the defaults collide.
# LIBRARY_PREFIX=generations
# LIBRARY_COLLECTION=generations

# ---- Optional: tuning --------------------------------------------------
# Port for server.js (Cloud Run injects its own). Defaults to 8080.
# PORT=8080

# How often the scheduler checks for due posts, in ms. Defaults to 60000.
# SCHEDULER_INTERVAL_MS=60000
